# Copy to .env for local runs without Docker (uv run uvicorn ...).
DATABASE_URL=sqlite:///./documents.db
API_KEYS=dev-key
LOG_LEVEL=INFO
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=5
WORKER_BACKOFF_BASE_SECONDS=2
WORKER_BACKOFF_MAX_SECONDS=60
# Demo only: share of processing attempts that fail on purpose (0.0 - 1.0).
SIMULATED_FAILURE_RATE=0
